{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keepframe",
  "version": "0.4.1",
  "identifier": "com.adobrov.photosorter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Keepframe",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNjIxQUJCQjUxMDZGMzMKUldRemJ4QzF1eHBpb21WZkpoMUYycHVlWVdDa051QVRveitPSzlJRi9qdUV0WCtaaXF2Tmt5Y2YK",
      "endpoints": [
        "https://github.com/adobrov-cloud/keepframe/releases/latest/download/latest.json"
      ]
    }
  }
}
